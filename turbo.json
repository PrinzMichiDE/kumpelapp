{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", ".expo/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "db:generate": {
      "dependsOn": ["^db:generate"]
    },
    "db:push": {
      "dependsOn": ["^db:push"]
    },
    "db:migrate": {
      "dependsOn": ["^db:migrate"]
    },
    "db:seed": {
      "dependsOn": ["^db:seed"]
    }
  }
}