# OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# League Data
LEAGUE_PROVIDER="openligadb"
OPENLIGADB_LEAGUE_SHORTCUT="rlno"
SEASON="2026/2027"

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""

# Ticket Parsing
TICKET_PDF_MAX_SIZE_MB="10"
TICKET_PDF_MAX_PAGES="5"
ENABLE_TICKET_PARSING="true"

# Firebase (Push)
FIREBASE_PROJECT_ID=""
