{
  "name": "@kumpelapp/db",
  "version": "0.0.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "prisma generate && tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "@kumpelapp/api-contracts": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^5.18.0",
    "typescript": "^5.6.2",
    "vitest": "^2.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.1"
  }
}