{
  "name": "kumpelapp",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "vercel-build": "pnpm --filter @kumpelapp/db db:generate && pnpm --filter webapp build && node -e \"const fs=require('fs');fs.rmSync('.next',{recursive:true,force:true});fs.cpSync('webapp/.next','.next',{recursive:true});if(fs.existsSync('webapp/public')){fs.rmSync('public',{recursive:true,force:true});fs.cpSync('webapp/public','public',{recursive:true});}fs.copyFileSync('webapp/package.json','package.webapp.json');\"",
    "ingest:venues": "tsx tooling/scripts/ingest-venues.ts",
    "ingest:away-info": "tsx tooling/scripts/ingest-away-info.ts",
    "ingest:traditions": "tsx tooling/scripts/ingest-traditions.ts",
    "ingest:quiz": "tsx tooling/scripts/ingest-quiz.ts",
    "ingest:squad": "tsx tooling/scripts/ingest-squad.ts",
    "ingest:news": "tsx tooling/scripts/ingest-news.ts",
    "ingest:streams": "tsx tooling/scripts/ingest-streams.ts",
    "ingest:tickets": "tsx tooling/scripts/ingest-tickets.ts",
    "season:rollover": "tsx tooling/scripts/season-rollover.ts",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "netlify:setup": "tsx tooling/scripts/setup-netlify-db.ts",
    "netlify:deploy": "netlify deploy --prod --dir=webapp/.next"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2",
    "netlify-cli": "^17.0.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "netlify": {
    "plugins": [
      "./netlify-plugin-postgres.js"
    ]
  }
}
